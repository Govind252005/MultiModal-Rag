# Multimodal RAG - Colab environment template
# Copy to .env in the project root and adjust values as needed.

RAG_DATA_HOME=/content/drive/MyDrive/MultimodalRag

# Backend runtime
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:4b
DEFAULT_PROVIDER=ollama
OCR_ENGINE=paddleocr

# Local-inference target (AUDIT_REPORT.md P1-2/P1-3): qwen3:4b, thinking
# disabled, bounded context/output, streaming on.
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_THINK=0
OLLAMA_STREAM=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=120
LLM_TEMPERATURE=0.1

# Cloud failover policy (AUDIT_REPORT.md P0-5): only rate-limit/network/
# server-error classes ever fail over to local Ollama, and only if this is
# on. Invalid keys and invalid requests always fail immediately, regardless
# of this setting.
PROVIDER_FAILOVER_TO_LOCAL=1
PROVIDER_RETRY_MAX_ATTEMPTS=2
CLOUD_TIMEOUT=60

# CORS (AUDIT_REPORT.md P0-1) — comma-separated allowlist of exact origins.
# Never use "*" for anything beyond a throwaway local demo.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL=0

# Auth hardening (AUDIT_REPORT.md P0-3/P0-4/P1-5)
TOKEN_TTL_HOURS=168
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
LOGIN_LOCKOUT_SECONDS=300
REGISTER_MAX_ATTEMPTS=10
REGISTER_WINDOW_SECONDS=3600
REGISTER_LOCKOUT_SECONDS=3600

# Rate limiting (brief §27)
CHAT_RATE_LIMIT_PER_MINUTE=30
INGEST_RATE_LIMIT_PER_HOUR=60

# Upload limits (brief §28)
MAX_UPLOAD_SIZE_MB=200
MAX_FILES_PER_REQUEST=20

# Retrieval settings
TEXT_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_BATCH_SIZE=64
DEFAULT_TOP_K=5
DENSE_CANDIDATES=40
BM25_CANDIDATES=40
RERANK_ENABLED=1
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Optional cloud provider integrations
GEMINI_MODEL=gemini-flash-latest
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-3-5-sonnet-latest
GROQ_MODEL=openai/gpt-oss-120b

# Storage / caching
CACHE_ENABLED=1
CACHE_TTL_SECONDS=600
REDIS_URL=redis://localhost:6379/0

# OCR tuning
PADDLEOCR_LANG=en
OCR_LANG=eng
OCR_CONFIG=--oem 1 --psm 6

# Advanced retrieval flags
QUERY_REWRITE_ENABLED=0
HYDE_ENABLED=0
MULTIHOP_ENABLED=0
COLBERT_ENABLED=0
