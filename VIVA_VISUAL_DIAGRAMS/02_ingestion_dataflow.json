  "cards": [
    {
      "dot": "emerald",
      "title": "Borderless Table Extraction",
      "items": [
        "_extract_row_aligned_text parses lines without physical borders by clustering horizontal baseline coordinates",
        "Preserves table headers, cell alignments, and columnar relationships in markdown",
        "Embeds bounding box coordinates [x0, y0, x1, y1] for frontend PDF viewer alignment"
      ]
    },
    {
      "dot": "cyan",
      "title": "Devanagari & Hindi Normalization",
      "items": [
        "Language detect module triggers specialized Devanagari regex cleaning",
        "Normalizes zero-width joiners (ZWJ), halant conjuncts, and vowel diacritics",
        "Tokens feed dual indexes ensuring keyword exact matches on Hindi legal/medical terms"
      ]
    },
    {
      "dot": "rose",
      "title": "Dual-Modal Embedding Storage",
      "items": [
        "all-MiniLM-L6-v2 encodes 512-token text windows into 384-dimensional dense vectors",
        "CLIP ViT-B-32 maps diagram crops and visual figures into 512-dimensional shared space",
        "Both collections persist in ChromaDB partitioned by tenant_id"
      ]
    }
  ]
}
