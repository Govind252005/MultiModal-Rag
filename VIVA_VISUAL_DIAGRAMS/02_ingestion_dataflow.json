  "flows": [
    { "id": "f1", "from": "pdf_sources", "to": "pymupdf_parser", "label": "raw PDF pages", "classification": "layout stream", "variant": "emphasis" },
    { "id": "f2", "from": "text_sources", "to": "devanagari_cleaner", "label": "Unicode text", "classification": "text stream", "variant": "default" },
    { "id": "f3", "from": "media_sources", "to": "multimodal_extract", "label": "frames & audio tracks", "classification": "multimedia", "variant": "default" },
    
    { "id": "f4", "from": "pymupdf_parser", "to": "semantic_chunker", "label": "table & text", "classification": "structured", "variant": "emphasis" },
    { "id": "f5", "from": "devanagari_cleaner", "to": "semantic_chunker", "label": "clean text", "classification": "tokens", "variant": "default" },
    { "id": "f6", "from": "multimodal_extract", "to": "semantic_chunker", "label": "transcripts", "classification": "textualized", "variant": "default" },
    
    { "id": "f7", "from": "semantic_chunker", "to": "text_embedder", "label": "semantic text passages", "classification": "text chunks", "variant": "emphasis" },
    { "id": "f8", "from": "multimodal_extract", "to": "clip_embedder", "label": "visual frame crops", "classification": "image arrays", "variant": "dashed" },
    { "id": "f9", "from": "semantic_chunker", "to": "bm25_lexical", "label": "token frequencies", "classification": "lexical tokens", "variant": "default" },
    
    { "id": "f10", "from": "text_embedder", "to": "chroma_store", "label": "384-d dense embeddings", "classification": "embeddings", "variant": "emphasis" },
    { "id": "f11", "from": "clip_embedder", "to": "chroma_store", "label": "512-d visual embeddings", "classification": "embeddings", "variant": "dashed" }
