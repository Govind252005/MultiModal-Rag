  "nodes": [
    { "id": "pdf_sources", "type": "frontend", "label": "PDF Documents", "sublabel": "Native & Scanned", "stage": 0, "row": 0, "tag": "Tables + Text" },
    { "id": "text_sources", "type": "frontend", "label": "DOCX & Hindi Text", "sublabel": "Devanagari scripts", "stage": 0, "row": 1, "tag": "Multilingual" },
    { "id": "media_sources", "type": "frontend", "label": "Media Assets", "sublabel": "PNG/JPG/MP3/MP4", "stage": 0, "row": 2, "tag": "Visual + Audio" },
    
    { "id": "pymupdf_parser", "type": "backend", "label": "pdf_docx_parser.py", "sublabel": "_extract_row_aligned_text", "stage": 1, "row": 0, "tag": "PyMuPDF" },
    { "id": "devanagari_cleaner", "type": "backend", "label": "Hindi Normalizer", "sublabel": "Unicode & Matra regex", "stage": 1, "row": 1, "tag": "Indic NLP" },
    { "id": "multimodal_extract", "type": "backend", "label": "PaddleOCR & Whisper", "sublabel": "BLIP visual captions", "stage": 1, "row": 2, "tag": "OCR + ASR" },
    
    { "id": "semantic_chunker", "type": "backend", "label": "chunker.py", "sublabel": "512-tok sliding window", "stage": 2, "row": 1, "tag": "Metadata Tagging" },
    
    { "id": "text_embedder", "type": "backend", "label": "Text Bi-Encoder", "sublabel": "all-MiniLM-L6-v2 (384-d)", "stage": 3, "row": 0, "tag": "Dense Vectors" },
    { "id": "clip_embedder", "type": "backend", "label": "Vision CLIP Model", "sublabel": "clip-ViT-B-32 (512-d)", "stage": 3, "row": 2, "tag": "Cross-Modal" },
    
    { "id": "chroma_store", "type": "database", "label": "ChromaDB Store", "sublabel": "vector_store.py", "stage": 4, "row": 0, "tag": "Cosine Index" },
    { "id": "bm25_lexical", "type": "database", "label": "BM25 Lexical Index", "sublabel": "lexical_index.py", "stage": 4, "row": 2, "tag": "v2_stemming" }
